)

proposal = edge.author(request)
workbench.retain_original(proposal)
workbench.open_review(proposal, owner=<span class="string">"design-system-owner"</span>)

<span class="comment"># Acceptance creates a new visible identity; it never rewrites old runs.</span>
accepted = workbench.accept_proposal(
    proposal.id,
    reviewer=<span class="string">"design-system-owner"</span>,
