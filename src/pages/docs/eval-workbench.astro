---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LabMark from "../../components/LabMark.astro";
import "../../styles/eval-workbench.css";

const journey = [
  {
    n: "01",
    name: "Connect",
    question: "Can we run the real thing safely?",
    copy: "Bind the existing agent command, workspace, reset boundary, evidence sources, credentials, destinations, and limits. Preflight should refuse before dispatch when a required capability is absent.",
    artifact: "Connection profile + capability result",
  },
  {
    n: "02",
    name: "Define",
    question: "What does good work mean here?",
    copy: "Turn owner-approved references and examples into criteria, scenarios, permitted alternatives, missing knowledge, and candidate checks. Meaning remains reviewable; generated rules do not approve themselves.",
    artifact: "Meaning epoch + proposed evaluation pack",
  },
  {
    n: "03",
    name: "Test",
    question: "Do the checks deserve authority?",
    copy: "Challenge the evaluator with correct, failing, unsupported, and unresolved controls. Freeze identities and the complete attempt plan before any decision-bearing run.",
    artifact: "Qualified pack + complete run plan",
  },
  {
    n: "04",
    name: "Investigate",
    question: "What failed—and what would change it?",
    copy: "Follow a verdict back to exact traces, artifacts, observed effects, gaps, and versions. Separate agent defects, evaluator defects, legitimate alternatives, and missing observations.",
    artifact: "Finding + reviewed hypothesis/change",
  },
  {
    n: "05",
    name: "Keep",
    question: "Will the lesson survive the next change?",
    copy: "Confirm against frozen expectations, preserve regressions and unknowns, retain the case, export the pack, and rerun it in a clean environment without depending on private authoring internals.",
    artifact: "Portable retained case + lineage",
  },
];

const evidenceKinds = [
  ["Recorded fixture", "Replays known bytes and evaluator behavior offline.", "Does not mean an agent ran now."],
  ["Worker transcript", "Records what the worker sent, received, and observed.", "Is not provider-signed or an independently observed effect."],
  ["Fresh execution", "Shows a newly dispatched candidate under a declared profile.", "Does not prove correctness beyond the evidence and qualified checks."],
  ["Independent effect", "Shows the app, customer workflow, CI, or business outcome changed.", "Cannot be inferred from a tool-call claim or synthetic control."],
];

const integrations = [
  {
    name: "Native fx ACP",
    when: "M1 reference agent",
    role: "Runs the actual target reasoning/tool loop and preserves native session behavior.",
    boundary: "Workbench owns experiment slots and capture—not fx’s internal execution model.",
    state: "planned",
  },
  {
    name: "shadcn + lint",
    when: "M1 domain pack",
    role: "Supplies a pinned settings app, design-system policy, diagnostics, fixtures, and rendering surface.",
    boundary: "Lint is one observation channel; lint-clean is not functional or visually correct.",
    state: "planned",
  },
  {
    name: "ProofPack",
    when: "foundation + native roadmap",
    role: "Binds evidence/evaluator identities, qualifications, graphs, and admitted execution receipts.",
    boundary: "Integrity is not truth. Native refusals, errors, and unknowns stay native.",
    state: "partial",
  },
  {
    name: "Assay",
    when: "descriptive M1; fuller M4",
    role: "Provides supported design, assignment, decision, replay, projection, and memory paths.",
    boundary: "A refusal is useful capability evidence, not positive inference or improvement.",
    state: "partial",
  },
  {
    name: "Private Edge",
    when: "M1 authoring boundary",
    role: "Proposes rubrics, skill/config changes, experiments, and later diagnoses from approved context.",
    boundary: "Returns typed proposals. It cannot approve meaning, authorize execution, or become a runtime dependency of accepted local packs.",
    state: "planned",
  },
  {
    name: "Vercel receipts",
    when: "adapter + later conformance",
    role: "Imports and verifies supported native receipt, diagnostic, and public decision artifacts.",
    boundary: "The bridge reads declared operations; it does not prove an external harness enforced a budget.",
    state: "partial",
  },
  {
    name: "Claude Agent SDK",
    when: "M2 candidate adapter",
    role: "A possible independently supplied customer-agent shape after the native fx reference loop works.",
    boundary: "Not required for M1 and not a reason to migrate the customer’s agent framework.",
    state: "later",
  },
  {
    name: "LangGraph",
    when: "M2 candidate adapter",
    role: "A later process adapter that can map an external agent into the same evidence and plan contracts.",
    boundary: "Reuses the shared substrate; it must not create a second scheduler or verdict language.",
    state: "later",
  },
];

const decisions = [
  ["Reference M1", "Native fx + one pinned shadcn settings app", "Decided", "Do not add a second framework."],
  ["Experiment", "Common lint-assisted baseline; reviewed skill is the only treatment delta", "Decided", "Freeze actual prompt/model/runtime and policy."],
  ["Session inventory", "U0 + 6 development + review + 6 confirmation + fresh R01 = 14", "Conditional", "Workflow demonstration, not statistical power; allowance required."],
  ["Meaning owner", "Named reviewer independent of checker author", "Open", "Needed before V02/V05 closure."],
  ["fx runtime", "Exact source/build, model connection, Node/browser/container profile", "Held", "Local v0.0.8 binary is not the required admitted build."],
  ["Edge service", "Repository, endpoint, release owner, and egress policy", "Open", "Server ownership begins only after the boundary is named."],
  ["Assay gate", "Actual native capability outcome/refusal in descriptive M1", "Decided", "Supported inference remains held if capability refuses."],
  ["Customer proof", "Independent owner, clean CI, later real change, repeated use", "Later", "Internal demonstration cannot close M2/M3."],
];

const nextWork = [
  ["V01", "Freeze the offline handoff", "Sergio + Alvaro review", "Exact repo trees, fixture lock, adapters, commands, gaps, and reproducible runtime requirements—without live dispatch."],
  ["V02–V05", "Pack, runtime, checks, controls", "Sergio lead", "Build the settings fixture and qualified verifier inventory; name the independent meaning/control reviewer."],
  ["V06–V07", "Edge proposal + reviewed skill", "Alvaro server / Sergio client", "Set the private API boundary, retain originals and views, review the portable skill, and prove local use without Edge."],
  ["V08–V10", "Fresh fx capture + investigation", "Sergio lead", "Run only after admission and budget authorization; capture session/effects/effort and preserve the actual Assay outcome."],
  ["V11–V12", "Confirm, retain, export", "Shared", "Freeze C, run R01 fresh, expose the five-view journey, install the pack in clean internal CI."],
  ["V13", "Independent counterpart", "Alvaro lead", "Customer/Vercel review, clean CI, and a later real change. This is the first customer-shaped acceptance gate."],
];

const critiques = [
  {
    title: "The plan is already wider than the first learning question.",
    issue: "Fourteen sessions, multiple native systems, a private service, UI, portability, and independent effects can turn M1 into an integration program before product value is felt.",
    move: "Define one five-minute ‘honest verdict’ demo and keep every other M1 task visibly subordinate to it. If a task does not improve Connect → verdict → why → keep, defer it.",
  },
  {
    title: "A neat experiment can still be an unhelpful product.",
    issue: "Three pairs per phase can demonstrate mechanics while saying little about usefulness. The design also risks optimizing for the test packet rather than a maintainer’s real decision.",
    move: "Measure setup time, owner-review time, false alarms, unresolved gaps, investigation time, and whether the retained case changes a later decision—not just checks passed.",
  },
  {
    title: "The evidence vocabulary is a feature, but it can overwhelm onboarding.",
    issue: "Identity, qualification, authority, evidence, and lifecycle are necessary internally. Exposing them all at once makes the tool feel like a compliance console.",
    move: "Default to a decision card: outcome, why, confidence boundary, next action. Let experts expand exact identities, native receipts, and transition history in place.",
  },
  {
    title: "Edge can become a dependency disguised as intelligence.",
    issue: "If the authoring service is required to interpret every failure or rerun a pack, customer control and portability are weakened.",
    move: "Treat Edge as a proposal compiler. Every accepted result is an inspectable artifact; every accepted pack runs locally after Edge is disconnected.",
  },
  {
    title: "Native integration breadth can hide a weak customer story.",
    issue: "ProofPack, Assay, receipts, replay, memory, and adapters are powerful foundations, but completing all of them before independent use delays the market test.",
    move: "Close only the native path that the current claim needs. Preserve refusals. Move full conformance and second-consumer extraction to M4 as planned.",
  },
  {
    title: "‘Local by default’ needs an actual egress experience.",
    issue: "A policy statement is not enough when Edge or a hosted judge receives selected context.",
    move: "Show the exact payload before sending: files, excerpts, purpose, destination, retention, budget, and grant. Store the approved envelope with the returned proposal.",
  },
];

const sources = [
  ["Runtime foundation", "PR #1 / corrected code identity", "222fadc"],
  ["Product architecture", "merged PR #6 docs", "426ec91"],
  ["fx execution plan", "PR #7 head under review", "e75be60"],
  ["Portable spec suite", "lab-specs local head", "94abbe3"],
  ["Explainer snapshot", "local synthesis", "2026-09-15"],
];
---

<BaseLayout
  title="Evaluation Workbench — Product field guide"
  description="A local-only, full-spectrum explainer for the Evaluation Workbench: current foundation, fx MVP, long-term architecture, integrations, evidence, code paths, and product critique."
  noindex={true}
>
  <div class="ew-page" data-focus="all" id="top">
    <header class="ew-nav">
      <LabMark href="/" />
      <nav class="ew-nav__links" aria-label="Explainer sections">
        <a href="#overview">10 ft</a>
        <a href="#journey">Journey</a>
        <a href="#architecture">360°</a>
        <a href="#spec-format">Spec</a>
        <a href="#walkthrough">Today</a>
        <a href="#mvp">Next</a>
        <a href="#roadmap">Roadmap</a>
        <a href="#critique">Review</a>
      </nav>
      <span class="local-flag"><i></i> Local field guide</span>
    </header>

    <main id="main">
      <section class="ew-hero" aria-labelledby="hero-title">
        <div class="ew-hero__copy">
          <p class="section-code">HPAL / Evaluation systems / 2026</p>
          <h1 id="hero-title">Make “good” <em>executable.</em></h1>
          <p class="ew-hero__lead">Evaluation Workbench is a customer-controlled path from an agent and a human definition of good to qualified checks, bounded runs, understandable evidence, and cases that survive the next change.</p>
          <div class="hero-actions">
            <a class="ew-btn ew-btn--primary" href="#overview">Orient in 90 seconds <span>↓</span></a>
            <a class="ew-btn" href="#install">Run the current slice <span>↘</span></a>
          </div>
          <dl class="hero-facts">
            <div><dt>Current</dt><dd>Offline recorded/imported foundation</dd></div>
            <div><dt>Next</dt><dd>One complete native fx + shadcn loop</dd></div>
            <div><dt>Later</dt><dd>Independent customer use + reusable methods</dd></div>
          </dl>
        </div>
        <figure class="hero-figure">
          <img src="/img/explainers/eval-workbench/workbench-loop.webp" width="1536" height="1024" alt="An operator threads a red evidence cord through artifacts, test gates, and an archive, with a deliberate gap left in the loop." />
          <figcaption><b>Visual thesis.</b> The foundation becomes a product only when meaning, execution, evidence, correction, and retention close one honest loop. The remaining gap is intentional.</figcaption>
        </figure>
        <div class="status-strip" aria-label="Claim boundary">
          <span><i class="dot dot--current"></i><b>Shipped</b> means implemented and locally verified.</span>
          <span><i class="dot dot--next"></i><b>Proposed</b> means specified, not yet demonstrated.</span>
          <span><i class="dot dot--later"></i><b>Later</b> means gated by independent evidence.</span>
        </div>
      </section>

      <section class="ew-section ew-section--overview" id="overview">
        <div class="section-intro">
          <div>
            <p class="section-code">01 / The 10-foot view</p>
            <h2>One product.<br />Three horizons.</h2>
          </div>
          <div>
            <p>The short version is not “an eval dashboard.” It is a system for deciding whether a change preserved work people rely on—and retaining enough meaning and evidence to make that decision again.</p>
            <div class="focus-controls" role="group" aria-label="Focus a product horizon">
              <button type="button" class="is-active" data-focus-button="all" aria-pressed="true">All</button>
              <button type="button" data-focus-button="current" aria-pressed="false">Current</button>
              <button type="button" data-focus-button="next" aria-pressed="false">Next</button>
              <button type="button" data-focus-button="later" aria-pressed="false">Later</button>
            </div>
          </div>
        </div>

        <div class="horizon-grid">
          <article class="horizon-card horizon-card--current" data-horizon="current">
            <div class="card-top"><span class="state state--current">Current foundation</span><span>PR #1 · merged</span></div>
            <h3>An honest offline verdict over retained evidence.</h3>
            <p class="big-copy">A fictional supplier review proves the plumbing: versioned project inputs, recorded/imported artifacts, eight frozen checks, 0/1/2 exit semantics, evidence identities, CLI/UI inspection, export/install, and offline rescoring.</p>
            <ul class="check-list">
              <li>Beta recorded replay: 8/8 checks pass; no agent runs.</li>
              <li>Acme remains unresolved when approval evidence is insufficient.</li>
              <li>Pass, fail, unsupported, unresolved, error, and native refusal stay distinct.</li>
              <li>Portable packs include policy, referenced tasks/assets, controls, and tamper checks.</li>
            </ul>
            <div class="card-boundary"><b>Does not prove</b> a fresh provider run, independent app effects, customer meaning, admitted native artifacts, or adoption.</div>
          </article>

          <article class="horizon-card horizon-card--next" data-horizon="next">
            <div class="card-top"><span class="state state--next">Short term</span><span>M1 · specified</span></div>
            <h3>Close one full loop with native fx.</h3>
            <p class="big-copy">Use one pinned shadcn settings task to compare the same lint-assisted fx workflow with and without a reviewed design-system skill. Capture fresh sessions and independent app effects, investigate, confirm, and retain.</p>
            <ul class="check-list">
              <li>Separate meaning-owner and simulated task-user conversations.</li>
              <li>U0 + six D + six C + fresh R01: 14 bounded sessions, max three turns each.</li>
              <li>Only the skill changes between baseline and treatment.</li>
              <li>Function, visual intent, diagnostics, allowed changes, coverage, and effort all matter.</li>
            </ul>
            <div class="card-boundary"><b>Held today</b> exact admitted fx build/model/browser profile, named reviewers, Edge endpoint/egress, and provider allowance.</div>
          </article>

          <article class="horizon-card horizon-card--later" data-horizon="later">
            <div class="card-top"><span class="state state--later">Long term</span><span>M2 → M4</span></div>
            <h3>A maintained body of evaluation knowledge.</h3>
            <p class="big-copy">Independent teams connect their own agents, correct meaning, reuse portable packs in clean CI, and carry retained findings into later real changes. Private Edge methods improve without taking authority or portability away.</p>
            <ul class="check-list">
              <li>M2: independently supplied agent, owner review, clean CI, later change.</li>
              <li>M3: repeated use, useful findings, support effort, and payment decisions.</li>
              <li>M4: broader native conformance, replay/memory, later adapters, second-consumer core extraction.</li>
              <li>Customer execution, rules, raw evidence, cases, and findings remain exportable.</li>
            </ul>
            <div class="card-boundary"><b>Research direction</b> includes an independently implemented failure → hypothesis → frozen test → change → confirmation → retained-case pattern.</div>
          </article>
        </div>

        <aside class="north-star">
          <span class="north-star__label">The purchase question</span>
          <p>Can we change this agent <em>without breaking work our customers rely on?</em></p>
          <span class="north-star__note">The practical output is not a score. It is a reproducible finding, an honest comparison, and a versioned evaluation pack.</span>
        </aside>
      </section>

      <section class="ew-section" id="journey">
        <div class="section-intro section-intro--tight">
          <div>
            <p class="section-code">02 / Product spine</p>
            <h2>Five views.<br />One authority model.</h2>
          </div>
          <p>The UI, CLI, CI, and optional assistants are different projections over the same state transitions. None gets a secret shortcut around review, qualification, grants, or evidence.</p>
        </div>
        <ol class="journey">
          {journey.map((step) => (
            <li>
              <div class="journey__n">{step.n}</div>
              <div class="journey__name"><h3>{step.name}</h3><span>{step.question}</span></div>
              <p>{step.copy}</p>
              <div class="journey__artifact">Retains <b>{step.artifact}</b></div>
            </li>
          ))}
        </ol>
        <div class="authority-grid">
          <article><span>Human authority</span><h3>Meaning owner</h3><p>Approves business meaning, consequential alternatives, execution grants, and proposed changes.</p></article>
          <article><span>Operational authority</span><h3>Workbench</h3><p>Enforces lifecycle, identities, budgets, completeness, review state, and recoverable attempts.</p></article>
          <article><span>Native authority</span><h3>ProofPack / Assay</h3><p>Own their admitted results, qualifications, refusals, errors, and capability limits.</p></article>
          <article><span>Proposal authority</span><h3>Edge / assistants</h3><p>May inspect permitted context and propose artifacts; cannot self-approve or silently reinterpret history.</p></article>
        </div>
      </section>

      <section class="ew-section ew-section--dark" id="architecture">
        <div class="section-intro section-intro--light">
          <div>
            <p class="section-code">03 / The 360-degree view</p>
            <h2>The model is one component.<br />The boundaries are the product.</h2>
          </div>
          <p>Customer-side execution remains the source of operational fact. Shared contracts make those facts portable. Native systems keep their own authority. Edge contributes methods through a narrow, reviewable exchange.</p>
        </div>

        <div class="architecture-map" role="img" aria-label="Architecture map showing customer-owned workspace, Workbench shared services, native ProofPack and Assay systems, and a separate private Edge service connected by reviewed proposals and permitted context.">
          <div class="arch-zone arch-zone--customer">
            <div class="arch-zone__head"><span>Customer boundary</span><b>Local by default</b></div>
            <div class="arch-row arch-row--inputs">
              <div class="arch-node"><small>Existing system</small><strong>Agent + repository</strong><span>fx first; later external adapters</span></div>
              <div class="arch-node"><small>Human context</small><strong>Owner + task user</strong><span>Meaning, examples, corrections</span></div>
              <div class="arch-node"><small>Observed world</small><strong>Workspace + app</strong><span>Artifacts, traces, browser effects</span></div>
            </div>
            <div class="arch-arrow"><span>versioned inputs · fresh evidence · explicit grants</span></div>
            <div class="arch-core">
              <div class="arch-core__title"><small>One customer-side product</small><strong>Evaluation Workbench</strong><span>Connect · Define · Test · Investigate · Keep</span></div>
              <div class="arch-services">
                <span>Typed contracts</span><span>Durable scheduler</span><span>Qualification</span><span>Investigation</span><span>Comparison</span><span>Export + lineage</span>
              </div>
              <div class="arch-interfaces"><span>UI</span><span>CLI</span><span>CI</span><span>Worker API</span></div>
            </div>
            <div class="arch-arrow arch-arrow--down"><span>frozen plans · exact identities · native requests</span></div>
            <div class="arch-row arch-row--native">
              <div class="arch-node arch-node--native"><small>Native evidence</small><strong>ProofPack</strong><span>Binding, graph, qualification, admitted execution</span></div>
              <div class="arch-node arch-node--native"><small>Native inference</small><strong>Assay</strong><span>Design, assignment, decision, replay, memory</span></div>
              <div class="arch-node arch-node--native"><small>Domain adapters</small><strong>fx · shadcn · receipts</strong><span>Preserve source semantics and limits</span></div>
              <div class="arch-node arch-node--archive"><small>Durable customer asset</small><strong>Portable packs + cases</strong><span>Run without private authoring methods</span></div>
            </div>
          </div>

          <div class="edge-bridge" aria-hidden="true"><span>approved excerpts →</span><i></i><span>← typed proposals</span></div>

          <div class="arch-zone arch-zone--edge">
            <div class="arch-zone__head"><span>Separate service boundary</span><b>Private methods</b></div>
            <div class="edge-node"><small>Authoring</small><strong>Rubric decomposition</strong><span>Criteria, alternatives, questions, evidence needs</span></div>
            <div class="edge-node"><small>Engineering session</small><strong>Skill + experiment proposals</strong><span>Inspectable diffs and bounded operations</span></div>
            <div class="edge-node"><small>Later</small><strong>Diagnosis + method learning</strong><span>Qualified against useful findings, false alarms, and total effort</span></div>
            <div class="edge-refusal">No raw workspace by default.<br />No credentials. No approval token.<br />No hidden control truth.</div>
          </div>
        </div>

        <div class="architecture-principles">
          <p><b>Tool call ≠ effect.</b> A transcript saying “saved” is not a browser-observed saved state.</p>
          <p><b>Hash ≠ truth.</b> Identity proves which bytes were used, not that their claim is correct.</p>
          <p><b>Replay ≠ fresh run.</b> Rescoring evidence can test a checker change, not a new agent behavior.</p>
          <p><b>Source pin ≠ runtime.</b> An installed binary must be independently bound to its admitted source and build.</p>
        </div>
      </section>

      <section class="ew-section ew-section--spec" id="spec-format">
        <div class="section-intro">
          <div>
            <p class="section-code">04 / The spec format</p>
            <h2>Define the run inside.<br />Verify the claim outside.</h2>
          </div>
          <p>There are two related formats, and the distinction matters. Workbench’s internal packet says what should be evaluated. The separate <code>lab-specs</code> contracts say how a third party can inspect the resulting claim without importing our Python implementation.</p>
        </div>

        <div class="spec-layers">
          <article class="spec-layer spec-layer--internal">
            <div class="spec-layer__top"><span>Layer A</span><b>Workbench definition packet</b><em>Current internal contracts</em></div>
            <h3>What are we planning to test?</h3>
            <p>Authoring and execution use a closed, versioned packet. Every selected scenario, candidate or retained artifact, scorer, repetition, limit, observation, and required metric becomes a planned cell before execution.</p>
            <div class="spec-chain" aria-label="Workbench definition packet flow">
              <span>Outcome<br />meaning</span><i>→</i><span>Framework<br />pack</span><i>→</i><span>Lane</span><i>→</i><span>Scenario</span><i>→</i><span>Scorer<br />binding</span><i>→</i><span>Frozen<br />plan</span>
            </div>
            <ul>
              <li><code>FrameworkPackV2</code> declares metrics, lanes, scenarios, scorers, adapters, and qualification references.</li>
              <li><code>LaneV2</code> selects the execution or artifact route, candidates, repetitions, budgets, and required/advisory cells.</li>
              <li><code>ScenarioV2</code> names input, protected-reference, and output requirements plus applicability and split.</li>
              <li><code>ScorerBindingV2</code> pins a metric to its implementation, configuration, evidence needs, and qualification.</li>
            </ul>
          </article>

          <article class="spec-layer spec-layer--portable">
            <div class="spec-layer__top"><span>Layer B</span><b>Lab portable specifications</b><em>Implemented locally · distribution held</em></div>
            <h3>What does the result actually prove?</h3>
            <p>Language-neutral normative text, informative schemas, conformance corpora, and independent implementations define the bytes a verifier reads. Gaps are data, not missing fields or optimistic defaults.</p>
            <div class="spec-chain spec-chain--portable" aria-label="Portable spec verification flow">
              <span>Canonical<br />JSON</span><i>→</i><span>Eval<br />receipt</span><i>→</i><span>ProofPack<br />bundle</span><i>→</i><span>Assay<br />gate</span><i>→</i><span>Independent<br />verifier</span>
            </div>
            <ul>
              <li><code>lab-canonical-json/v1</code> gives every digest one exact cross-language byte encoding.</li>
              <li><code>eval-receipt/v1</code> records one evaluated cell: subject, context, attempts, selection, coverage, reuse, and unknowns.</li>
              <li><code>proofpack-evidence/v1</code> seals the exact artifact inventory around that receipt.</li>
              <li><code>lab-decision-gate/v1</code> maps registered thresholds and observed statistics to an Assay outcome.</li>
            </ul>
          </article>
        </div>

        <div class="spec-contracts">
          <article><span>01</span><small>Encoding</small><h3>Canonical JSON</h3><p>Strict UTF-8 JSON, Unicode code-point key order, integer and real kinds kept distinct, finite numbers only, and no serializer-default ambiguity.</p><b><code>digest(v) = sha256(E(v))</code></b></article>
          <article><span>02</span><small>Measurement</small><h3>Eval receipt</h3><p>One receipt per system/task cell. Every launch stays visible in order; selection and coverage must agree with the attempt ledger.</p><b>No aggregates hide attempts.</b></article>
          <article><span>03</span><small>Integrity</small><h3>Evidence bundle</h3><p><code>proof.lock</code> binds subject, context, paths, sizes, bytes, drift predicates, and the chained evidence log to one root.</p><b>Integrity, never truth.</b></article>
          <article><span>04</span><small>Decision</small><h3>Assay gate</h3><p>A pure function over registered thresholds and factual statistics returns <code>ADMIT</code>, <code>REFUSE</code>, or <code>INVALID_OR_UNVERIFIED</code>.</p><b>The input contains no verdict.</b></article>
          <article><span>05</span><small>Interop</small><h3>Conformance</h3><p>Any language speaks the same subprocess protocol and runs the same corpora. Agreement is tested byte-for-byte and code-for-code.</p><b>Spec text + vectors decide.</b></article>
        </div>

        <div class="spec-anatomy">
          <div class="spec-code">
            <div class="spec-code__head"><span class="state state--current">Abridged anatomy</span><b>Illustrative shape—not a valid conformance fixture</b></div>
            <pre><code>&#123;
  <span class="key">"schema_version"</span>: <span class="string">"eval-receipt/v1"</span>,
  <span class="key">"receipt_id"</span>: <span class="string">"fx/settings/D02/baseline/mapping-2"</span>,
  <span class="key">"receipt_version"</span>: <span class="number">1</span>,
  <span class="key">"produced_at"</span>: <span class="string">"2026-09-15T20:00:00Z"</span>,
  <span class="key">"producer"</span>: &#123;
