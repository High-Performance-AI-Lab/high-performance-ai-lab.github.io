---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import LabMark from "../components/LabMark.astro";
import GridMarker from "../components/GridMarker.astro";
import { SITE_LOCATION, SITE_NAME } from "../consts.ts";

const labUrl = "https://github.com/High-Performance-AI-Lab";
const muserUrl = `${labUrl}/muser`;
const kvpackUrl = `${labUrl}/kvpack`;
const consoleUrl = `${labUrl}/muser-console`;
const bookRepoUrl = `${labUrl}/muser-book`;
const bookUrl = "https://high-performance-ai-lab.github.io/muser-book/";

const team = (await getCollection("team"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);

// Real run conditions, not vibes — the tape restates the muser README.
const tape = [
  "MUSE GLIMMER · 52 LAYERS · ~30B",
  "METAL DECODE",
  "NVFP4 PREFILL · GB10",
  "EXACT-TOKEN MATCH · 5 REPS PER CELL",
  "WIRED 10GbE · EEE DISABLED",
  "PINNED COMPARATOR · 89e0aa6",
  "RECEIPTS RETAINED",
];
const tapeLoop = [...tape, ...tape];

// Above-the-fold numbers. Each restates a claim from the public muser README,
// conditions attached; the colophon carries the shared caveats.
const stats = [
  {
    value: "1.05×",
    label: "decode vs pinned llama.cpp",
    cond: "llama.cpp ÷ muser · 2,048 tok · 5-rep mean",
  },
  {
    value: "3.75–4.26×",
    label: "faster first token, GB10 prefill",
    cond: "5 counted reps per depth · deterministic output",
  },
  {
    value: "~65 ms",
    label: "warm local prefix resume",
    cond: "one Mac · exact-prefix hit",
  },
  {
    value: "8/8",
    label: "deep-handoff soak, no losses",
    cond: "130,815 tok per handoff · back to back",
  },
];

const roadmap = [
  {
    name: "Multi-producer scheduling",
    now: "today's qualified topology is one Mac and one GB10 node",
  },
  {
    name: "Node de-enrollment",
    now: "nodes can join in one command; leaving cleanly is next",
  },
  {
    name: "Remote multimodal prefill",
    now: "unqualified — requests with images fall back to local prefill",
  },
  {
    name: "The evaluation half",
    now: "how we decide whether an agent system worked — in private development",
  },
];
---

<BaseLayout
  title={SITE_NAME}
  description="High Performance AI Lab builds open inference systems and publishes the conditions behind every number — device, model, quant, and rep count."
>
  <header class="site-nav" data-header>
    <LabMark />
    <nav class="site-nav__links" aria-label="Primary">
      <a href="#ethos" data-nav-section="ethos"><span>01</span><b>Scope</b></a>
      <a href="#systems" data-nav-section="projects"><span>02</span><b>Systems</b></a>
      <a href="#founders" data-nav-section="founders"><span>03</span><b>Founders</b></a>
      <a href="#next" data-nav-section="next"><span>04</span><b>Next</b></a>
    </nav>
    <div class="site-nav__cta">
      <a class="btn btn--ghost" href={labUrl} target="_blank" rel="noreferrer">GitHub <b aria-hidden="true">↗</b></a>
      <a class="btn btn--primary" href={bookUrl} target="_blank" rel="noreferrer">Read the book <b aria-hidden="true">↗</b></a>
    </div>
  </header>

  <main id="main">
    <section class="hero lab-hero" id="top" tabindex="-1" aria-labelledby="hero-title">
      <div class="hero__copy">
        <span class="hero__status"><i aria-hidden="true"></i> Independent systems lab · Zurich + Buenos Aires</span>

        <h1 id="hero-title">
          High Performance<br /><span class="accent">AI Lab</span>.
        </h1>

        <p class="hero__lead">
          We're an independent lab for local AI. Intelligence you rely on should
          run on hardware you own, stay open to inspection, and be measured
          honestly. We build the pieces that make that possible — an inference
          engine, a state format that moves its work exactly, and, next, the
          machinery that proves an AI system did what it claims.
        </p>

        <div class="hero__cta">
          <a class="btn btn--primary" href="#systems">See the systems <b aria-hidden="true">↓</b></a>
          <a class="btn btn--ghost" href={bookUrl} target="_blank" rel="noreferrer">How it's built <b aria-hidden="true">↗</b></a>
        </div>

        <dl class="hero__stats" aria-label="Measured results from the muser benchmark suite">
          {stats.map((stat) => (
            <div class="hero__stat">
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
              <span class="hero__stat-cond">{stat.cond}</span>
            </div>
          ))}
        </dl>
      </div>

      <figure class="hero__art" aria-hidden="true">
        <div class="dither dither--ink" style="--plate:url('/img/hero-fitzroy-ink.png')"></div>
        <div class="dither dither--ox" style="--plate:url('/img/hero-fitzroy-ox.png')"></div>
        <figcaption>MONTE FITZ ROY · 49.27°S 73.04°W · FLOYD–STEINBERG · 1-BIT</figcaption>
      </figure>
    </section>

    <div class="tape" aria-hidden="true">
      <div class="tape__track">
        {tapeLoop.map((item) => <span>{item}</span>)}
      </div>
    </div>

    <section class="section section--narrow" id="ethos" aria-labelledby="ethos-title" data-observed-section data-section="ethos">
      <div class="section-mark"><GridMarker step={1} /><span class="section-code">01 / SCOPE</span></div>
      <h2 id="ethos-title">A model is only one part of the system.</h2>
      <p>
        We work from the job that needs doing to the hardware that does it: the
        engine, the state it keeps, the kernels underneath, and the evidence that
        says whether any of it worked. Say what you measured. Name the machine.
        Show the receipt.
      </p>
      <p class="ethos-rule">
        Measured, or it doesn't ship.
      </p>
    </section>

    <div class="band-horizon" role="img" aria-label="The Matterhorn, dithered to one bit">
      <div class="band-horizon__plate" style="--plate:url('/img/band-matterhorn-solo.png')"></div>
      <span class="band-horizon__caption">45.98°N 7.66°E · MATTERHORN · ZERMATT</span>
    </div>

    <section class="section section--tinted" id="systems" aria-labelledby="systems-title" data-observed-section data-section="projects">
      <div class="section-head section-head--flipped">
        <div>
          <div class="section-mark"><GridMarker step={2} /><span class="section-code">02 / SYSTEMS · OPEN SOURCE</span></div>
          <h2 id="systems-title">The systems we've<br />released so far.</h2>
        </div>
        <p>
          Four open repositories: the engine, the cache format it replays, the
          dashboard that watches it, and the book that explains how it all works.
        </p>
      </div>

      <ol class="ledger">
        <li class="ledger__row">
          <span class="ledger__index">01</span>
          <div class="ledger__body">
            <h3><a href={muserUrl} target="_blank" rel="noreferrer">muser <b aria-hidden="true">↗</b></a></h3>
            <p class="ledger__claim">
              We built Muser to show what local inference can be: Muse Glimmer,
              a 52-layer ~30B model, running well on one Mac — with the option
              of handing long prompts to a GPU node for prefill. On our
              exact-token benchmarks it matches or beats a source-pinned
              llama.cpp at every depth we tested, with or without speculation.
            </p>
            <p class="ledger__limit">On natural text, speculation helps on some content and not on others — the benchmarks publish both sides.</p>
          </div>
          <span class="ledger__tag">ENGINE · RUST + METAL</span>
        </li>
        <li class="ledger__row">
          <span class="ledger__index">02</span>
          <div class="ledger__body">
            <h3><a href={kvpackUrl} target="_blank" rel="noreferrer">kvpack <b aria-hidden="true">↗</b></a></h3>
            <p class="ledger__claim">
              We built kvpack because a computed KV cache is work worth keeping.
              It saves inference state and restores exactly the same bytes —
              after a restart, a crash, or on another machine — and it refuses
              state that doesn't match the model, tokenizer, and configuration
              it came from. The refusal is the point: a wrong restore should
              never be silent.
            </p>
            <p class="ledger__limit">Cross-engine reuse works when two adapters deliberately share a representation — kvpack doesn't invent one.</p>
          </div>
          <span class="ledger__tag">STATE · RUST</span>
        </li>
        <li class="ledger__row">
          <span class="ledger__index">03</span>
          <div class="ledger__body">
            <h3><a href={consoleUrl} target="_blank" rel="noreferrer">muser-console <b aria-hidden="true">↗</b></a></h3>
            <p class="ledger__claim">
              The dashboard we wanted while running Muser: fleet health, cache
              savings, and live sessions, with one rule everywhere — missing
              data stays visibly missing. No zero-filling, no demo numbers, no
              gaps quietly connected on a chart.
            </p>
            <p class="ledger__limit">One Rust binary and one checked-in HTML page — no CDN, no package tree, no frontend build.</p>
          </div>
          <span class="ledger__tag">TELEMETRY · RUST</span>
        </li>
        <li class="ledger__row">
          <span class="ledger__index">04</span>
          <div class="ledger__body">
            <h3><a href={bookUrl} target="_blank" rel="noreferrer">How to Write an Inference Engine <b aria-hidden="true">↗</b></a></h3>
            <p class="ledger__claim">
              Everything we learned building these systems, written down: how
              one token is generated on Apple Silicon, how the speculative
              lanes work, how kvpack replays state exactly, and how a GPU node
              hands prefill to a Mac. Forty chapters, with every measured
              number cited to a receipt.
            </p>
            <p class="ledger__limit"><a href={bookUrl} target="_blank" rel="noreferrer">Read it online ↗</a> · <a href={bookRepoUrl} target="_blank" rel="noreferrer">source ↗</a></p>
          </div>
          <span class="ledger__tag">BOOK · 40 CHAPTERS</span>
        </li>
      </ol>
    </section>

    <section class="section disagg" id="architecture" aria-labelledby="architecture-title" data-observed-section data-section="projects">
      <div class="section-head">
        <div>
          <div class="section-mark"><GridMarker step={3} /><span class="section-code">02 / SYSTEMS · DISAGGREGATED</span></div>
          <h2 id="architecture-title">Prefill on a GB10.<br />Decode on a <span class="accent">Mac</span>.</h2>
        </div>
        <p>
          vLLM prefills long context in NVFP4 on a GB10 node; Muser decodes on
          Apple Metal. At 130,815 tokens that is 137.4 s to first token instead
          of 570.1 s — 4.15×, five counted reps, deterministic output in every one.
        </p>
      </div>

      <div class="role-map role-map--hybrid" aria-label="Disaggregated prefill with vLLM on NVIDIA CUDA and decode with Muser on Apple Metal">
        <article class="role-map__node role-map__node--producer">
          <div class="role-map__top"><span>01 / LONG-PROMPT PREFILL</span><b>CUDA</b></div>
          <div class="role-map__icon" aria-hidden="true">N</div>
          <h3>Prefill on NVIDIA.</h3>
          <p>vLLM processes long context in NVFP4 on a DGX Spark or another GB10-class machine.</p>
          <ul><li>DGX Spark / GB10</li><li>vLLM</li><li>NVFP4 prefill</li></ul>
        </article>

        <div class="role-map__handoff" aria-label="Authenticated verified state handoff">
          <span>02 / VERIFIED STATE HANDOFF</span>
          <div aria-hidden="true"><i></i><b>KV</b><i></i></div>
          <p>kvpack · TLS + HMAC<br />mismatch → reject</p>
        </div>

        <article class="role-map__node role-map__node--consumer role-map__node--muser">
          <div class="role-map__top"><span>03 / TOKEN-BY-TOKEN DECODE</span><b>METAL</b></div>
          <div class="role-map__icon" aria-hidden="true">M</div>
          <h3>Decode with Muser.</h3>
          <p>The Mac verifies identity and integrity, installs the KV state, then Muser continues generation with Metal.</p>
          <ul><li>Apple Silicon</li><li>Muser</li><li>Metal decode</li></ul>
        </article>
      </div>

      <div class="reuse-ladder">
        <div class="reuse-ladder__step"><b>~65 ms</b><span>warm local prefix, one Mac</span></div>
        <div class="reuse-ladder__step"><b>0.61 s / 1.06 s</b><span>warm 65k / 131k prefix with a producer — vs 68.6 s / 147.8 s cold, bit-identical output</span></div>
        <div class="reuse-ladder__step"><b>54.2851%</b><span>of the bytes moved for a half-cached prompt, output SHA-256 equal to a full handoff's</span></div>
        <div class="reuse-ladder__step reuse-ladder__step--miss"><b>~12.9 s</b><span>a miss through the same path stays slow — measured reuse, not cache-forever</span></div>
      </div>

      <p class="architecture-caption">
        <strong>One request, two architectures.</strong> The Mac checks identity
        and integrity before installing anything; a mismatch is rejected, and
        the rejection keeps its receipt. The demonstrated topology is one
        GB10-class producer and one Mac consumer — scale-out is what we're
        working on next. We also tried speculative decoding across the wire:
        it didn't pay for itself, so we published the negative result and
        moved on.
      </p>
    </section>

    <div class="band-horizon" role="img" aria-label="The towers of Torres del Paine, dithered to one bit">
      <div class="band-horizon__plate" style="--plate:url('/img/band-paine-solo.png')"></div>
      <span class="band-horizon__caption">50.94°S 72.99°W · TORRES DEL PAINE · PATAGONIA</span>
    </div>

    <section class="section section--tinted" id="founders" aria-labelledby="founders-title" data-observed-section data-section="founders">
      <div class="section-head founders-head">
        <div>
          <div class="section-mark"><GridMarker step={4} /><span class="section-code">03 / FOUNDERS</span></div>
          <h2 id="founders-title">Behind the lab.</h2>
        </div>
        <p>One of us lives in Zurich, the other in Buenos Aires; Patagonia is the shared love. The lab is the two of us, building these systems end to end.</p>
      </div>

      <div class="team-ledger">
        {team.map((member, index) => (
          <article class:list={["team-record", `accent-${member.accent}`]}>
            <div class="team-record__portrait" aria-hidden="true">
              <div class="dither dither--ink" style={`--plate:url('/img/${index === 0 ? "place-zurich" : "place-patagonia"}-ink.png')`}></div>
              <div class="dither dither--tint" style={`--plate:url('/img/${index === 0 ? "place-zurich" : "place-patagonia"}-ox.png')`}></div>
            </div>
            <div class="team-record__identity">
              <p class="eyebrow">Co-founder · {member.role}</p>
              <h3>{member.name}</h3>
              <div class="team-record__links">
                {member.github && <a href={member.github} target="_blank" rel="noreferrer">GitHub ↗</a>}
                {member.website && <a href={member.website} target="_blank" rel="noreferrer">Website ↗</a>}
              </div>
            </div>
            <div class="team-record__profile">
              <p>{member.bio}</p>
              {member.location && <span>{member.location}</span>}
            </div>
          </article>
        ))}
      </div>

      <aside class="team-note">
        <span>COLLABORATION::OPEN</span>
        <p>If you're building local AI and care about honest measurement, we'd like to hear from you.</p>
        <a href={labUrl} target="_blank" rel="noreferrer">Read the code <span aria-hidden="true">↗</span></a>
      </aside>
    </section>

    <section class="section future" id="next" aria-labelledby="next-title" data-observed-section data-section="next">
      <div class="section-head">
        <div>
          <div class="section-mark"><GridMarker step={4} /><span class="section-code">04 / WHAT FOLLOWS</span></div>
          <h2 id="next-title">What we're working on.</h2>
        </div>
        <p>The next pieces of work, and where each one stands today.</p>
      </div>

      <ol class="roadmap">
        {roadmap.map((item, index) => (
          <li class="roadmap__row">
            <span class="roadmap__index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.name}</h3>
            <p>{item.now}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="cta-band">
      <div class="cta-band__plate" aria-hidden="true" style="--plate:url('/img/band-matterhorn-ink.png')"></div>
      <div class="cta-band__inner">
        <span class="eyebrow">OPEN SOURCE</span>
        <h2>Run it. Check the numbers.</h2>
        <p>All of it is open — clone the repos, run the benchmarks, and see for yourself.</p>
        <div class="cta-band__actions">
          <a class="btn btn--paper" href={bookUrl} target="_blank" rel="noreferrer">Read the book <b aria-hidden="true">↗</b></a>
          <a class="btn btn--paper-ghost" href={labUrl} target="_blank" rel="noreferrer">The lab on GitHub <b aria-hidden="true">↗</b></a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-footer__brand">
      <span>HPAL / END OF INDEX</span>
      <h2>Systems you can inspect,<br />from task to silicon.</h2>
    </div>
    <div class="site-footer__cols">
      <div class="site-footer__col"><span>Systems</span><a href={muserUrl} target="_blank" rel="noreferrer">muser ↗</a><a href={kvpackUrl} target="_blank" rel="noreferrer">kvpack ↗</a><a href={consoleUrl} target="_blank" rel="noreferrer">muser-console ↗</a><a href={bookUrl} target="_blank" rel="noreferrer">the book ↗</a></div>
      <div class="site-footer__col"><span>Lab</span><a href="#ethos">Scope</a><a href="#founders">Founders</a><a href="#next">What follows</a></div>
      <div class="site-footer__col"><span>Connect</span><a href={labUrl} target="_blank" rel="noreferrer">GitHub ↗</a><a href="#top">Back to top ↑</a></div>
    </div>
    <div class="colophon">
      <span>COLOPHON</span>
      <p>
        Set in Inter, IBM Plex Sans, and JetBrains Mono. Photography dithered to
        one bit, Floyd–Steinberg, 2px dot: Monte Fitz Roy by Raven Winters
        (CC BY 4.0); the Matterhorn by Sam Ferrara (CC0); Torres del Paine by
        Winky (CC BY 2.0); Fitz Roy massif and the Lauterbrunnen valley, public
        domain — all via Wikimedia Commons. Numbers on this page restate the
        muser and kvpack READMEs; each carries its conditions, and the receipts
        stay in the repos.
      </p>
    </div>
    <div class="site-footer__base"><span>© 2026 {SITE_NAME} — {SITE_LOCATION}</span><a href="#top">RETURN TO 000 ↑</a></div>
  </footer>

  <script>
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const revealItems = document.querySelectorAll<HTMLElement>(".reveal");
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        revealObserver.unobserve(entry.target);
      });
    }, { threshold: 0.08 });
    revealItems.forEach((item) => revealObserver.observe(item));

    const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav-section]");
    const observedSections = document.querySelectorAll<HTMLElement>("[data-observed-section]");
    const sectionObserver = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible) return;
      navLinks.forEach((link) => link.classList.toggle("is-active", link.dataset.navSection === (visible.target as HTMLElement).dataset.section));
    }, { rootMargin: "-18% 0px -58% 0px", threshold: [0, 0.15, 0.5] });
    observedSections.forEach((section) => sectionObserver.observe(section));

    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      link.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const id = link.getAttribute("href")?.slice(1);
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        event.preventDefault();
        const distance = Math.abs(target.getBoundingClientRect().top);
        target.scrollIntoView({ behavior: prefersReducedMotion.matches || distance > window.innerHeight * 1.6 ? "auto" : "smooth", block: "start" });
        history.pushState(null, "", `#${id}`);
        window.setTimeout(() => target.focus({ preventScroll: true }), distance > window.innerHeight * 1.6 ? 0 : 450);
      });
    });
  </script>
</BaseLayout>
