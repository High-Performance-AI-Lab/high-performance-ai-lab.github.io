---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LabMark from "../../components/LabMark.astro";
import { SITE_SHORT_NAME } from "../../consts.ts";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.url);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
const { Content } = await render(article);
const articleDate = article.data.publishedAt.toLocaleDateString("en-GB", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
const assetBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title={article.data.title} description={article.data.description}>
  <div class="page-grain" aria-hidden="true"></div>
  <header class="article-header">
    <LabMark href={assetBase} />
    <a href={assetBase}>Back to the lab index <span aria-hidden="true">↖</span></a>
  </header>

  <main id="main" class="article-page">
    <header class="article-page__mast">
      <div class="article-page__meta">
        <span>{article.data.kind.replace("-", " ")}</span>
        <span>{articleDate}</span>
        <span>{article.data.readingTime} read</span>
      </div>
      <p class="eyebrow">{SITE_SHORT_NAME} / DISPATCH::{article.id.toUpperCase()}</p>
      <h1>{article.data.title}</h1>
      <p class="article-page__dek">{article.data.description}</p>
      <div class="article-page__byline">
        <span>Written by</span><strong>{article.data.author}</strong>
      </div>
    </header>

    <article class="prose">
      <Content />
    </article>

    <footer class="article-page__footer">
      <p>Filed under {article.data.tags.join(" / ")}</p>
      <a href={`${assetBase}#dispatches`}>More dispatches <span aria-hidden="true">→</span></a>
    </footer>
  </main>
</BaseLayout>
