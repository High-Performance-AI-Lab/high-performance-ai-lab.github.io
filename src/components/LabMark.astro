---
import { SITE_NAME } from "../consts.ts";

interface Props {
  href?: string;
}

const { href = "#top" } = Astro.props;
---

<a class="lab-mark" href={href} aria-label={`${SITE_NAME}, back to home`}>
  <span class="lab-mark__glyph" aria-hidden="true">
    <span>H</span><span>P</span>
  </span>
  <span class="lab-mark__name">High Performance<br />AI Lab</span>
</a>
