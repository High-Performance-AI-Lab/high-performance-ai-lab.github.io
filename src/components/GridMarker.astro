---
// Section marker: the lab mark's 4x4 memory grid as a progress glyph.
// Section `step` (1-4) lights the first `step` columns of the measured
// series (1,3,2,4); the newest column's top cell is the oxide decode head.
interface Props {
  step: number;
}
const { step } = Astro.props;
const HEIGHTS = [1, 3, 2, 4];
const BLENDS = ["var(--teal)", "#137383", "#167098", "#1a6cac", "#1e69c1", "#2166d6", "var(--cobalt)"];
const cells = [];
for (let c = 0; c < 4; c++) {
  for (let r = 0; r < 4; r++) {
    const lit = c < step && r < HEIGHTS[c];
    const head = lit && c === step - 1 && r === HEIGHTS[c] - 1;
    cells.push({
      x: c * 11,
      y: (3 - r) * 11,
      fill: head ? "var(--accent)" : lit ? BLENDS[Math.min(c + r, 6)] : "rgba(28,25,23,0.14)",
    });
  }
}
---

<svg class="grid-marker" viewBox="0 0 42 42" aria-hidden="true">
  {cells.map((cell) => <rect x={cell.x} y={cell.y} width="9" height="9" rx="2" fill={cell.fill} />)}
</svg>
